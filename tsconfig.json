{
  "compilerOptions": {
    "sourceMap": true,
    "jsx": "react",
    "target": "ES2016",
    "module": "ES2020",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "lib": ["ES2016", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@hooks/*": ["src/app/hooks/*"]
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
